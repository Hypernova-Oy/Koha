.IX Title "Koha::Auth::Identity::Referer 3pm"
.TH Koha::Auth::Identity::Referer 3pm "2026-06-25" "perl v5.32.1" "User Contributed Perl Documentation"
.\" For nroff, turn off justification.  Always turn off hyphenation; it makes
.\" way too many mistakes in technical documents.
.if n .ad l
.nh
.SH "NAME"
Koha::Auth::Identity::Referer
.SH "SYNOPSIS"
.IX Header "SYNOPSIS"
.Vb 1
\&    use Koha::Auth::Identity::Referer;
\&
\&    Koha::Auth::Identity::Referer\->store_referer({
\&        referer => $c\->req\->headers\->referer,
\&        interface => $interface,
\&        session => $session,
\&    });
\&
\&    my $target_uri = Koha::Auth::Identity::Referer\->get_referer({
\&        session => $session,
\&    });
.Ve
.SH "DESCRIPTION"
.IX Header "DESCRIPTION"
.Vb 2
\&    Class for working with HTTP referrers specifically for
\&    when doing SSO.
.Ve
.SH "FUNCTIONS"
.IX Header "FUNCTIONS"
.SS "store_referer"
.IX Subsection "store_referer"
.Vb 5
\&    Koha::Auth::Identity::Referer\->store_referer({
\&        referer => $c\->req\->headers\->referer,
\&        interface => $interface,
\&        session => $session,
\&    });
\&
\&    If the referer is for a Koha URL, then it gets saved
\&    in a session variable for use after a successful SSO login.
.Ve
.SS "get_referer"
.IX Subsection "get_referer"
.Vb 3
\&    my $target_uri = Koha::Auth::Identity::Referer\->get_referer({
\&        session => $session,
\&    });
\&
\&    If a referer was stored in a session variable, then we retrieve
\&    it for use by SSO functionality. That is, after a successful SSO, we\*(Aqll
\&    redirect to this referer, so we wind up back where we started.
.Ve
