msgid "accounting.pref"
msgstr "accounting.pref"

# Accounting
msgid "accounting.pref Features"
msgstr "Funksies"

# Accounting
msgid "accounting.pref Policy"
msgstr "Beleid"

# Accounting > Policy > AccountAutoReconcile
msgid "accounting.pref#AccountAutoReconcile# Do"
msgstr "Doen"

# Accounting > Policy > AccountAutoReconcile
msgid "accounting.pref#AccountAutoReconcile# Don't"
msgstr "Vermy"

# Accounting > Policy > AccountAutoReconcile
msgid "accounting.pref#AccountAutoReconcile# reconcile patron balances automatically on each transaction adding debits or credits."
msgstr "outomatiese versoening van gebruikersbalanse by elke transaksie wat debiete of krediete byvoeg."

# Accounting > Features > AutoCreditNumber
msgid "accounting.pref#AutoCreditNumber# Automatic generation also has to be enabled for each credit type (<a href=\"/cgi-bin/koha/admin/credit_types.pl\">Configure credit types</a>)."
msgstr "Outomatiese generering moet ook vir elke krediettipe geaktiveer wees (<a href=\"/cgi-bin/koha/admin/credit_types.pl\">Konfigureer krediettipes</a>)."

# Accounting > Features > AutoCreditNumber
msgid "accounting.pref#AutoCreditNumber# Automatically generate credit numbers in the form 1, 2, 3"
msgstr "Genereer kredietnommers outomaties in die vorm 1, 2, 3"

# Accounting > Features > AutoCreditNumber
msgid "accounting.pref#AutoCreditNumber# Automatically generate credit numbers in the form <branchcode>yyyymm0001"
msgstr "Genereer kredietnommers outomaties in die vorm <branchcode>yyyymm0001"

# Accounting > Features > AutoCreditNumber
msgid "accounting.pref#AutoCreditNumber# Automatically generate credit numbers in the form <year>-0001"
msgstr "Genereer kredietnommers outomaties in die vorm <year>-0001"

# Accounting > Features > AutoCreditNumber
msgid "accounting.pref#AutoCreditNumber# Do not automatically generate credit numbers"
msgstr "Verhoed outomatiese generering van kredietnommers"

# Accounting > Features > EnablePointOfSale
msgid "accounting.pref#EnablePointOfSale#  the point of sale feature to allow anonymous transactions with the accounting system. (Requires <a href=\"/cgi-bin/koha/admin/preferences.pl?op=search&searchfield=UseCashRegisters\">UseCashRegisters</a>.)"
msgstr "die verkooppuntfunksie om anonieme transaksies met die rekeningkundestelsel toe te laat. (Vereis <a href=\"/cgi-bin/koha/admin/preferences.pl?op=search&searchfield=UseCashRegisters\">UseCashRegisters</a>.)"

# Accounting > Features > EnablePointOfSale
msgid "accounting.pref#EnablePointOfSale# Disable"
msgstr "Deaktiveer"

# Accounting > Features > EnablePointOfSale
msgid "accounting.pref#EnablePointOfSale# Enable"
msgstr "Aktiveer"

# Accounting > Policy > FinePaymentAutoPopup
msgid "accounting.pref#FinePaymentAutoPopup# Do"
msgstr "Vertoon"

# Accounting > Policy > FinePaymentAutoPopup
msgid "accounting.pref#FinePaymentAutoPopup# Don't"
msgstr "Verberg"

# Accounting > Policy > FinePaymentAutoPopup
msgid "accounting.pref#FinePaymentAutoPopup# automatically display a print dialog for a payment receipt when making a payment."
msgstr "outomaties 'n drukdialoog vir 'n betalingskwitansie wanneer 'n betaling gemaak word."

# Accounting > Features > RequireCashRegister
msgid "accounting.pref#RequireCashRegister# . (Requires <a href=\"/cgi-bin/koha/admin/preferences.pl?op=search&searchfield=UseCashRegisters\">UseCashRegisters</a>)"
msgstr ". (Vereis <a href=\"/cgi-bin/koha/admin/preferences.pl?op=search&searchfield=UseCashRegisters\">UseCashRegisters</a>)"

# Accounting > Features > RequireCashRegister
msgid "accounting.pref#RequireCashRegister# When collecting a payment, "
msgstr "Wanneer 'n betaling ontvang word, "

# Accounting > Features > RequireCashRegister
msgid "accounting.pref#RequireCashRegister# always require a cash register"
msgstr "vereis altyd 'n kasregister"

# Accounting > Features > RequireCashRegister
msgid "accounting.pref#RequireCashRegister# require a cash register only when the CASH payment type is selected"
msgstr "vereis 'n kasregister slegs wanneer die CASH-betalingstipe gekies is"

# Accounting > Policy > RequirePaymentType
msgid "accounting.pref#RequirePaymentType# Don't require"
msgstr "Stel opsioneel"

# Accounting > Policy > RequirePaymentType
msgid "accounting.pref#RequirePaymentType# Require"
msgstr "Vereis"

# Accounting > Policy > RequirePaymentType
msgid "accounting.pref#RequirePaymentType# This preference has no effect when <a href=\"/cgi-bin/koha/admin/preferences.pl?op=search&searchfield=UseCashRegisters\">UseCashRegisters</a> is enabled or when no payment types are defined in the <a href=\"/cgi-bin/koha/admin/authorised_values.pl?searchfield=PAYMENT_TYPE\">PAYMENT_TYPE</a> authorized value category."
msgstr "Hierdie voorkeur het geen effek wanneer <a href=\"/cgi-bin/koha/admin/preferences.pl?op=search&searchfield=UseCashRegisters\">UseCashRegisters</a> geaktiveer is of wanneer geen betalingstipes in die <a href=\"/cgi-bin/koha/admin/authorised_values.pl?searchfield=PAYMENT_TYPE\">PAYMENT_TYPE</a> gemagtigde waarde-kategorie gedefinieer is nie."

# Accounting > Policy > RequirePaymentType
msgid "accounting.pref#RequirePaymentType# staff to select a payment type when a payment is made."
msgstr "dat personeel 'n betalingstipe kies wanneer 'n betaling gemaak word."

# Accounting > Policy > RoundFinesAtPayment
msgid "accounting.pref#RoundFinesAtPayment# Do"
msgstr "Doen"

# Accounting > Policy > RoundFinesAtPayment
msgid "accounting.pref#RoundFinesAtPayment# Don't"
msgstr "Vermy"

# Accounting > Policy > RoundFinesAtPayment
msgid "accounting.pref#RoundFinesAtPayment# round fines to the nearest cent when collecting payments. Enabling this preference allows paying fines of partial cents which may not be visible in the interface."
msgstr "afronding van boetes tot die naaste sent wanneer betalings geïn word. Die aktivering van hierdie voorkeur laat die betaling van boetes van gedeeltelike sente toe, wat dalk nie in die koppelvlak sigbaar is nie."

# Accounting > Features > UseCashRegisters
msgid "accounting.pref#UseCashRegisters#  cash registers with the accounting system to track payments."
msgstr "kasregisters saam met die rekeningkundige stelsel om betalings na te spoor."

# Accounting > Features > UseCashRegisters
msgid "accounting.pref#UseCashRegisters# <p class='text-danger'><strong>Warning:</strong> Enabling this setting will make the register a required field for all CASH type transactions; This includes SIP00 transactions, so please ensure your SIP configurations are updated to map a register to your SIP device.</p>"
msgstr "<p class='text-danger'><strong>Waarskuwing:</strong> Die aktivering van hierdie instelling maak die kasregister 'n verpligte veld vir alle CASH-tipe transaksies; Dit sluit SIP00-transaksies in, maak dus asseblief seker dat u SIP-konfigurasies bygewerk is om 'n kasregister aan u SIP-toestel te koppel.</p>"

# Accounting > Features > UseCashRegisters
msgid "accounting.pref#UseCashRegisters# Don't use"
msgstr "Vermy"

# Accounting > Features > UseCashRegisters
msgid "accounting.pref#UseCashRegisters# Use"
msgstr "Gebruik"

msgid "acquisitions.pref"
msgstr "acquisitions.pref"

# Acquisitions
msgid "acquisitions.pref EDIFACT"
msgstr "EDIFACT"

# Acquisitions
msgid "acquisitions.pref Policy"
msgstr "Beleid"

# Acquisitions
msgid "acquisitions.pref Printing"
msgstr "Drukwerk"

# Acquisitions > Printing > 1PageOrderPDFText
msgid "acquisitions.pref#1PageOrderPDFText# <br><strong>NOTE:</strong> To prevent the bottom of your text from being cut off by the order table please do not save more than 3 lines of text in this system preference.</span>"
msgstr "<br><strong>LET WEL:</strong> Om te voorkom dat die onderkant van u teks deur die besteltabel afgesny word, moet u nie meer as 3 reëls teks in hierdie stelselvoorkeur stoor nie.</span>"

# Acquisitions > Printing > 1PageOrderPDFText
msgid "acquisitions.pref#1PageOrderPDFText# Text to be used above the order table in the English 1-page order PDF file. Note: Press enter to add line breaks to your sentence."
msgstr "Teks wat bo die besteltabel in die Engelse 1-bladsy bestelling-PDF-lêer gebruik moet word. Let wel: Druk enter om reëlbreuke by u sin te voeg."

# Acquisitions > Policy > AcqCreateItem
msgid "acquisitions.pref#AcqCreateItem# Create an item when"
msgstr "Skep 'n eksemplaar wanneer"

# Acquisitions > Policy > AcqCreateItem
msgid "acquisitions.pref#AcqCreateItem# This is only the default behavior, and can be changed per-basket."
msgstr "Dit is slegs die standaardgedrag en kan per mandjie gewysig word."

# Acquisitions > Policy > AcqCreateItem
msgid "acquisitions.pref#AcqCreateItem# cataloging the record."
msgstr "die rekord gekatalogiseer word."

# Acquisitions > Policy > AcqCreateItem
msgid "acquisitions.pref#AcqCreateItem# placing an order."
msgstr "'n bestelling geplaas word."

# Acquisitions > Policy > AcqCreateItem
msgid "acquisitions.pref#AcqCreateItem# receiving an order."
msgstr "'n bestelling ontvang word."

# Acquisitions > Policy > AcqEnableFiles
msgid "acquisitions.pref#AcqEnableFiles# Do"
msgstr "Doen"

# Acquisitions > Policy > AcqEnableFiles
msgid "acquisitions.pref#AcqEnableFiles# Don't"
msgstr "Vermy"

# Acquisitions > Policy > AcqEnableFiles
msgid "acquisitions.pref#AcqEnableFiles# enable the ability to upload and attach arbitrary files to invoices."
msgstr "aktivering van die vermoë om arbitrêre lêers na fakture op te laai en te heg."

# Acquisitions > Policy > AcqItemSetSubfieldsWhenReceiptIsCancelled
msgid "acquisitions.pref#AcqItemSetSubfieldsWhenReceiptIsCancelled# Upon cancelling a receipt, update the item's subfields if they were created when placing an order (e.g. o=5|a=\"bar foo\"):"
msgstr "By die kansellering van 'n ontvangs, werk die eksemplaar se subvelde by as hulle geskep is toe die bestelling geplaas is (bv. o=5|a=\"bar foo\"):"

# Acquisitions > Policy > AcqItemSetSubfieldsWhenReceived
msgid "acquisitions.pref#AcqItemSetSubfieldsWhenReceived# Upon receiving items, update their subfields if they were created when placing an order (e.g. o=5|a=\"foo bar\"):"
msgstr "Wanneer eksemplare ontvang word, werk hul subvelde by as hulle geskep is toe die bestelling geplaas is (bv. o=5|a=\"foo bar\"):"

# Acquisitions > Policy > AcqViewBaskets
msgid "acquisitions.pref#AcqViewBaskets# Show baskets"
msgstr "Wys mandjies"

# Acquisitions > Policy > AcqViewBaskets
msgid "acquisitions.pref#AcqViewBaskets# created or managed by staff member."
msgstr "wat deur die personeellid geskep of bestuur word."

# Acquisitions > Policy > AcqViewBaskets
msgid "acquisitions.pref#AcqViewBaskets# from staff member's library."
msgstr "van die personeellid se biblioteek."

# Acquisitions > Policy > AcqViewBaskets
msgid "acquisitions.pref#AcqViewBaskets# in system, regardless of owner."
msgstr "in die stelsel, ongeag die eienaar."

# Acquisitions > Policy > AcqWarnOnDuplicateInvoice
msgid "acquisitions.pref#AcqWarnOnDuplicateInvoice# Do not warn"
msgstr "Weerhou waarskuwing"

# Acquisitions > Policy > AcqWarnOnDuplicateInvoice
msgid "acquisitions.pref#AcqWarnOnDuplicateInvoice# Warn"
msgstr "Waarsku"

# Acquisitions > Policy > AcqWarnOnDuplicateInvoice
msgid "acquisitions.pref#AcqWarnOnDuplicateInvoice# when the librarian tries to create an invoice with a duplicate number."
msgstr "wanneer die bibliotekaris 'n faktuur met 'n duplikaatnommer probeer skep."

# Acquisitions > Policy > AcquisitionsDefaultEmailAddress
msgid "acquisitions.pref#AcquisitionsDefaultEmailAddress# <br>If left empty, it will fall back to the first defined address in the following list: library email, <a href=\"/cgi-bin/koha/admin/preferences.pl?op=search&searchfield=KohaAdminEmailAddress\">KohaAdminEmailAddress</a>."
msgstr "<br>Indien dit leeg gelaat word, val dit terug op die eerste adres wat in die volgende lys gedefinieer is: biblioteek-e-pos, <a href=\"/cgi-bin/koha/admin/preferences.pl?op=search&searchfield=KohaAdminEmailAddress\">KohaAdminEmailAddress</a>."

# Acquisitions > Policy > AcquisitionsDefaultEmailAddress
msgid "acquisitions.pref#AcquisitionsDefaultEmailAddress# Use the from email address"
msgstr "Gebruik die van-e-posadres"

# Acquisitions > Policy > AcquisitionsDefaultEmailAddress
msgid "acquisitions.pref#AcquisitionsDefaultEmailAddress# when sending acquisitions order and claim notices."
msgstr "wanneer aanskaffingsbestellings- en aanmaningskennisgewings gestuur word."

# Acquisitions > Policy > AcquisitionsDefaultReplyTo
msgid "acquisitions.pref#AcquisitionsDefaultReplyTo# <br>If left empty, it will fall back to the first defined address in the following list: library reply-to, library email, <a href=\"/cgi-bin/koha/admin/preferences.pl?op=search&searchfield=ReplytoDefault\">ReplytoDefault</a>, <a href=\"/cgi-bin/koha/admin/preferences.pl?op=search&searchfield=KohaAdminEmailAddress\">KohaAdminEmailAddress</a>."
msgstr "<br>Indien dit leeg gelaat word, val dit terug op die eerste adres wat in die volgende lys gedefinieer is: biblioteek antwoord-aan, biblioteek-e-pos, <a href=\"/cgi-bin/koha/admin/preferences.pl?op=search&searchfield=ReplytoDefault\">ReplytoDefault</a>, <a href=\"/cgi-bin/koha/admin/preferences.pl?op=search&searchfield=KohaAdminEmailAddress\">KohaAdminEmailAddress</a>."

# Acquisitions > Policy > AcquisitionsDefaultReplyTo
msgid "acquisitions.pref#AcquisitionsDefaultReplyTo# Use the reply-to email address"
msgstr "Gebruik die antwoord-aan-e-posadres"

# Acquisitions > Policy > AcquisitionsDefaultReplyTo
msgid "acquisitions.pref#AcquisitionsDefaultReplyTo# when sending acquisitions order and claim notices."
msgstr "wanneer aanskaffingsbestellings- en aanmaningskennisgewings gestuur word."

# Acquisitions > Policy > BasketConfirmations
msgid "acquisitions.pref#BasketConfirmations# When closing or reopening a basket,"
msgstr "Wanneer 'n mandjie gesluit of heropen word,"

# Acquisitions > Policy > BasketConfirmations
msgid "acquisitions.pref#BasketConfirmations# always ask for confirmation."
msgstr "vra altyd bevestiging."

# Acquisitions > Policy > BasketConfirmations
msgid "acquisitions.pref#BasketConfirmations# do not ask for confirmation."
msgstr "slaan bevestiging oor."

# Acquisitions > Policy > CalculateFundValuesIncludingTax
msgid "acquisitions.pref#CalculateFundValuesIncludingTax# Exclude"
msgstr "Sluit uit"

# Acquisitions > Policy > CalculateFundValuesIncludingTax
msgid "acquisitions.pref#CalculateFundValuesIncludingTax# Include"
msgstr "Sluit in"

# Acquisitions > Policy > CalculateFundValuesIncludingTax
msgid "acquisitions.pref#CalculateFundValuesIncludingTax# tax in the calculated fund values (spent, ordered). Note this rule applies to all vendors regardless of their configuration."
msgstr "belasting by die berekende fondswaardes (bestee, bestel). Let wel: hierdie reël geld vir alle verskaffers, ongeag hul konfigurasie."

# Acquisitions > Policy > CancelOrdersInClosedBaskets
msgid "acquisitions.pref#CancelOrdersInClosedBaskets# Allow"
msgstr "Laat toe"

# Acquisitions > Policy > CancelOrdersInClosedBaskets
msgid "acquisitions.pref#CancelOrdersInClosedBaskets# Don't allow"
msgstr "Verhoed"

# Acquisitions > Policy > CancelOrdersInClosedBaskets
msgid "acquisitions.pref#CancelOrdersInClosedBaskets# cancelling order lines in closed baskets."
msgstr "dat bestelreëls in geslote mandjies gekanselleer word."

# Acquisitions > Policy > ClaimsBccCopy
msgid "acquisitions.pref#ClaimsBccCopy# Don't send"
msgstr "Weerhou"

# Acquisitions > Policy > ClaimsBccCopy
msgid "acquisitions.pref#ClaimsBccCopy# Send"
msgstr "Stuur"

# Acquisitions > Policy > ClaimsBccCopy
msgid "acquisitions.pref#ClaimsBccCopy# blind copy (BCC) to logged in user when sending serial or acquisitions claims notices."
msgstr "blinde kopie (BCC) aan die aangemelde gebruiker stuur nie wanneer aanmaningskennisgewings vir vervolgpublikasies of aanskaffings gestuur word."

# Acquisitions > Policy > CurrencyFormat
msgid "acquisitions.pref#CurrencyFormat# 360 000,00 (FR)"
msgstr "360 000,00 (FR)"

# Acquisitions > Policy > CurrencyFormat
msgid "acquisitions.pref#CurrencyFormat# 360'000.00 (CH)"
msgstr "360'000.00 (CH)"

# Acquisitions > Policy > CurrencyFormat
msgid "acquisitions.pref#CurrencyFormat# 360,000.00 (US)"
msgstr "360,000.00 (US)"

