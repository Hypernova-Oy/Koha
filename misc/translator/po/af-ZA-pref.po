msgid "acquisitions.pref#CurrencyFormat# Display currencies using the following format"
msgstr "Vertoon geldeenhede in die volgende formaat"

# Acquisitions > EDIFACT > EDIFACT
msgid "acquisitions.pref#EDIFACT# Disable"
msgstr "Deaktiveer"

# Acquisitions > EDIFACT > EDIFACT
msgid "acquisitions.pref#EDIFACT# EDIFACT message exchange for acquisitions."
msgstr "EDIFACT-boodskapuitruiling vir aanskaffings."

# Acquisitions > EDIFACT > EDIFACT
msgid "acquisitions.pref#EDIFACT# Enable"
msgstr "Aktiveer"

# Acquisitions > EDIFACT > EdifactInvoiceImport
msgid "acquisitions.pref#EdifactInvoiceImport#  automatically import EDIFACT invoice message files when they are downloaded."
msgstr "outomatiese invoer van EDIFACT-faktuurboodskaplêers wanneer hulle afgelaai word."

# Acquisitions > EDIFACT > EdifactInvoiceImport
msgid "acquisitions.pref#EdifactInvoiceImport# Do"
msgstr "Doen"

# Acquisitions > EDIFACT > EdifactInvoiceImport
msgid "acquisitions.pref#EdifactInvoiceImport# Don't"
msgstr "Vermy"

# Acquisitions > EDIFACT > EdifactLSQ
msgid "acquisitions.pref#EdifactLSQ#  in items."
msgstr "in eksemplare."

# Acquisitions > EDIFACT > EdifactLSQ
msgid "acquisitions.pref#EdifactLSQ# Map sequence code (GIR:LSQ) field to "
msgstr "Karteer die volgordekode (GIR:LSQ)-veld na "

# Acquisitions > EDIFACT > EdifactLSQ
msgid "acquisitions.pref#EdifactLSQ# collection"
msgstr "versameling"

# Acquisitions > EDIFACT > EdifactLSQ
msgid "acquisitions.pref#EdifactLSQ# location"
msgstr "ligging"

# Acquisitions > Policy > EmailPurchaseSuggestions
msgid "acquisitions.pref#EmailPurchaseSuggestions# <br>If you choose <a href=\"/cgi-bin/koha/admin/preferences.pl?op=search&searchfield=EmailAddressForSuggestions\">EmailAddressForSuggestions</a> you have to enter a valid email address:"
msgstr "<br>As u <a href=\"/cgi-bin/koha/admin/preferences.pl?op=search&searchfield=EmailAddressForSuggestions\">EmailAddressForSuggestions</a> kies, moet u 'n geldige e-posadres invoer:"

# Acquisitions > Policy > EmailPurchaseSuggestions
msgid "acquisitions.pref#EmailPurchaseSuggestions# Choose email address that new purchase suggestions will be sent to: "
msgstr "Kies die e-posadres waarheen nuwe aankoopvoorstelle gestuur sal word: "

# Acquisitions > Policy > EmailPurchaseSuggestions
msgid "acquisitions.pref#EmailPurchaseSuggestions# EmailAddressForSuggestions"
msgstr "EmailAddressForSuggestions"

# Acquisitions > Policy > EmailPurchaseSuggestions
msgid "acquisitions.pref#EmailPurchaseSuggestions# KohaAdminEmailAddress"
msgstr "KohaAdminEmailAddress"

# Acquisitions > Policy > EmailPurchaseSuggestions
msgid "acquisitions.pref#EmailPurchaseSuggestions# email address of library"
msgstr "e-posadres van biblioteek"

# Acquisitions > Policy > EmailPurchaseSuggestions
msgid "acquisitions.pref#EmailPurchaseSuggestions# none"
msgstr "geen"

# Acquisitions > Policy > MarcFieldsToOrder
msgid "acquisitions.pref#MarcFieldsToOrder# <br><p>When there is no mapping for price, Koha will use 345$c and 020$c for MARC21 records and 345$c and 010$c for UNIMARC records.</p>"
msgstr "<br><p>Wanneer daar geen kartering vir prys is nie, sal Koha 345$c en 020$c vir MARC21-rekords en 345$c en 010$c vir UNIMARC-rekords gebruik.</p>"

# Acquisitions > Policy > MarcFieldsToOrder
msgid "acquisitions.pref#MarcFieldsToOrder# <p>For example:<br/>price: 947$a|947$c<br/>quantity: 969$h<br/>budget_code: 922$a</p>"
msgstr "<p>Byvoorbeeld:<br/>price: 947$a|947$c<br/>quantity: 969$h<br/>budget_code: 922$a</p>"

# Acquisitions > Policy > MarcFieldsToOrder
msgid "acquisitions.pref#MarcFieldsToOrder# <p>You can use the following fields: price, replacementprice, quantity, budget_code, discount, sort1, sort2</p>"
msgstr "<p>U kan die volgende velde gebruik: price, replacementprice, quantity, budget_code, discount, sort1, sort2</p>"

# Acquisitions > Policy > MarcFieldsToOrder
msgid "acquisitions.pref#MarcFieldsToOrder# Set the mapping values for a new order line created from a MARC record in a staged file."
msgstr "Stel die karteringswaardes vir 'n nuwe bestelreël wat uit 'n MARC-rekord in 'n gereedgemaakte lêer geskep word."

# Acquisitions > Policy > MarcItemFieldsToOrder
msgid "acquisitions.pref#MarcItemFieldsToOrder# <br/>For example:<br/>holdingbranch: 975$b<br/>itype: 975$9|975$z"
msgstr "<br/>Byvoorbeeld:<br/>holdingbranch: 975$b<br/>itype: 975$9|975$z"

# Acquisitions > Policy > MarcItemFieldsToOrder
msgid "acquisitions.pref#MarcItemFieldsToOrder# <p>If a field is missing or not mapped, <a href=\"/cgi-bin/koha/admin/preferences.pl?op=search&searchfield=MarcFieldsToOrder\">MarcFieldsToOrder</a> will be checked and used for that field (except quantity).</p>"
msgstr "<p>As 'n veld ontbreek of nie gekarteer is nie, sal <a href=\"/cgi-bin/koha/admin/preferences.pl?op=search&searchfield=MarcFieldsToOrder\">MarcFieldsToOrder</a> nagegaan en vir daardie veld gebruik word (behalwe quantity).</p>"

# Acquisitions > Policy > MarcItemFieldsToOrder
msgid "acquisitions.pref#MarcItemFieldsToOrder# Set the mapping values for new item records created from a MARC record in a staged file."
msgstr "Stel die karteringswaardes vir nuwe eksemplaarrekords wat uit 'n MARC-rekord in 'n gereedgemaakte lêer geskep word."

# Acquisitions > Policy > MarcItemFieldsToOrder
msgid "acquisitions.pref#MarcItemFieldsToOrder# You can use the following fields: homebranch, holdingbranch, itype, nonpublic_note, public_note, loc, ccode, notforloan, uri, copyno, price, replacementprice, itemcallnumber, coded_location_qualifier, barcode, and enumchron. Special fields: quantity and budget_code"
msgstr "U kan die volgende velde gebruik: homebranch, holdingbranch, itype, nonpublic_note, public_note, loc, ccode, notforloan, uri, copyno, price, replacementprice, itemcallnumber, coded_location_qualifier, barcode, en enumchron. Spesiale velde: quantity en budget_code"

# Acquisitions > Policy > MarcOrderingAutomation
msgid "acquisitions.pref#MarcOrderingAutomation# Disable"
msgstr "Deaktiveer"

# Acquisitions > Policy > MarcOrderingAutomation
msgid "acquisitions.pref#MarcOrderingAutomation# Enable"
msgstr "Aktiveer"

# Acquisitions > Policy > MarcOrderingAutomation
msgid "acquisitions.pref#MarcOrderingAutomation# automatic order line creation from MARC records."
msgstr "outomatiese skepping van bestelreëls vanaf MARC-rekords."

# Acquisitions > Printing > OrderPdfFormat
msgid "acquisitions.pref#OrderPdfFormat# English 1-page"
msgstr "Engels 1-bladsy"

# Acquisitions > Printing > OrderPdfFormat
msgid "acquisitions.pref#OrderPdfFormat# English 2-page"
msgstr "Engels 2-bladsy"

# Acquisitions > Printing > OrderPdfFormat
msgid "acquisitions.pref#OrderPdfFormat# English 3-page"
msgstr "Engels 3-bladsy"

# Acquisitions > Printing > OrderPdfFormat
msgid "acquisitions.pref#OrderPdfFormat# French 3-page"
msgstr "Frans 3-bladsy"

# Acquisitions > Printing > OrderPdfFormat
msgid "acquisitions.pref#OrderPdfFormat# German 2-page"
msgstr "Duits 2-bladsy"

# Acquisitions > Printing > OrderPdfFormat
msgid "acquisitions.pref#OrderPdfFormat# Use the"
msgstr "Gebruik die"

# Acquisitions > Printing > OrderPdfFormat
msgid "acquisitions.pref#OrderPdfFormat# layout when printing basket groups."
msgstr "uitleg wanneer mandjiegroepe gedruk word."

# Acquisitions > Policy > OrderPriceRounding
msgid "acquisitions.pref#OrderPriceRounding# Determines whether full precision values or rounded values should be used in price calculations."
msgstr "Bepaal of waardes met volle presisie of afgeronde waardes in prysberekeninge gebruik moet word."

# Acquisitions > Policy > OrderPriceRounding
msgid "acquisitions.pref#OrderPriceRounding# Don't round"
msgstr "Vermy afronding"

# Acquisitions > Policy > OrderPriceRounding
msgid "acquisitions.pref#OrderPriceRounding# Round"
msgstr "Rond af"

# Acquisitions > Policy > OrderPriceRounding
msgid "acquisitions.pref#OrderPriceRounding# to nearest cent.<br>"
msgstr "tot die naaste sent.<br>"

