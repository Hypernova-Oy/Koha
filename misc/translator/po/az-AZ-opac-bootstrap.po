#: koha-tmpl/opac-tmpl/bootstrap/en/modules/ilsdi.tt:464
#, c-format
msgid "Given a list of authority record identifiers, returns a list of record objects that contain the authority records. The function user may request a specific metadata schema for the record objects."
msgstr "\"Verilmiş avtoritet qeyd identifikatorları siyahısı əsasında həmin avtoritet qeydlərini ehtiva edən qeyd obyektlərinin siyahısını qaytarır. Funksiya istifadəçisi qaytarılacaq qeyd obyektləri üçün xüsusi bir meta-məlumat (metadata) sxemi tələb edə bilər.\""

#: koha-tmpl/opac-tmpl/bootstrap/en/modules/ilsdi.tt:469
#, c-format
msgid "list of authority record identifiers"
msgstr "Avtoritet qeyd identifikatorlarının siyahısı"

#: koha-tmpl/opac-tmpl/bootstrap/en/modules/ilsdi.tt:470
#, c-format
msgid "schema"
msgstr "Sxem"

#: koha-tmpl/opac-tmpl/bootstrap/en/modules/ilsdi.tt:472
#, c-format
msgid "specifies the metadata schema of records to be returned, possible values: "
msgstr "Qaytarılacaq qeydlərin meta-məlumat (metadata) sxemini müəyyən edir, mümkün dəyərlər: "

