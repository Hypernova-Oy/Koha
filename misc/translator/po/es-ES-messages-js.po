msgstr "¡Error! Su etiqueta contenía caracteres incorrectos.  NO fue agregada.  Por favor intente nuevamente con texto plano."

#: koha-tmpl/opac-tmpl/bootstrap/js/tags.js:81
msgid "Error! Illegal parameter"
msgstr "¡Error! Parámetro ilegal"

#: koha-tmpl/opac-tmpl/bootstrap/js/tags.js:86
msgid "Note: your tag contained markup code that was removed. The tag was added as "
msgstr "Nota: su etiqueta contenía código que fue removido. La etiqueta fue agregada como "

#: koha-tmpl/opac-tmpl/bootstrap/js/tags.js:94
msgid "Error! Adding tags failed at"
msgstr "¡Error! La adición de etiquetas falló en"

#: koha-tmpl/opac-tmpl/bootstrap/js/tags.js:99
msgid "Note: you can only tag an item with a given term once.  Check 'Tags' to see your current tags."
msgstr "Nota: Sólo puede etiquetar un ítem con un término una vez.  Verificar 'Etiquetas' para ver sus etiquetas utilizadas."

#: koha-tmpl/opac-tmpl/bootstrap/js/tags.js:105
msgid "Error! You cannot delete the tag"
msgstr "Error! No puede eliminar la etiqueta"

#: koha-tmpl/opac-tmpl/bootstrap/js/tags.js:109
msgid "Note: you can only delete your own tags."
msgstr "Nota: sólo puede eliminar sus propias etiquetas."

#: koha-tmpl/opac-tmpl/bootstrap/js/tags.js:113
msgid "You must be logged in to add tags."
msgstr "Debe ingresar a su cuenta para agregar etiquetas."

#: koha-tmpl/opac-tmpl/bootstrap/js/tags.js:185
msgid "Unable to add one or more tags."
msgstr "No se pudo agregar una o más etiquetas."

