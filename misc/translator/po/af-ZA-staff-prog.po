#, c-format
msgid "Hints"
msgstr "Wenke"

#: koha-tmpl/intranet-tmpl/prog/en/modules/tools/holidays.tt:288
#, c-format
msgid "Search in the calendar the day you want to set as holiday."
msgstr "Soek in die kalender die dag wat u as vakansiedag wil instel."

#: koha-tmpl/intranet-tmpl/prog/en/modules/tools/holidays.tt:289
#, c-format
msgid "Click the date to add or edit a holiday."
msgstr "Klik op die datum om 'n vakansiedag by te voeg of te wysig."

#: koha-tmpl/intranet-tmpl/prog/en/modules/tools/holidays.tt:290
#, c-format
msgid "Enter a title and description for the holiday."
msgstr "Voer 'n titel en beskrywing vir die vakansiedag in."

