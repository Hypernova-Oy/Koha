msgstr ""
"%sOnlayn katalog funksional kukilardan foydalanadi: ular saytning ishlashi "
"uchun zarurdir.%s"

#: installer/data/mysql/en/optional/sample_news.yml:additional_contents_localizations:2:row:6:mul:1
