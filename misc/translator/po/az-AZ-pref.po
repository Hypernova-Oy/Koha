# Circulation > Checkin policy > UpdateItemLocationOnCheckin
msgid "circulation.pref#UpdateItemLocationOnCheckin# FIC: GEN - causes an item in the Fiction location to be updated into the General stacks location on check in.<br/>"
msgstr "circulation.pref#UpdateItemLocationOnCheckin# FIC: GEN - qaytarılma zamanı Fiction yerləşməsində olan nüsxəni General stacks yerləşməsinə dəyişir.<br/>"

# Circulation > Checkin policy > UpdateItemLocationOnCheckin
msgid "circulation.pref#UpdateItemLocationOnCheckin# FIC: _BLANK_ - causes an item in location FIC to be updated to a blank location on check in.<br/>"
msgstr "Bədii kitab qaytarılanda yeri silinir, boş qalır"

# Circulation > Checkin policy > UpdateItemLocationOnCheckin
msgid "circulation.pref#UpdateItemLocationOnCheckin# General rule: if the location value on the left of the colon (:) matches the item's current location, it will be updated to match the location value on the right of the colon (:).<br/>"
msgstr "circulation.pref#UpdateItemLocationOnCheckin# Ümumi qayda: iki nöqtədən (:) sol tərəfdəki yerləşmə dəyəri nüsxənin cari yerləşməsi ilə uyğun gəlirsə, o, iki nöqtədən (:) sağ tərəfdəki yerləşmə dəyərinə uyğun olaraq yenilənəcək.<br/>"

# Circulation > Checkin policy > UpdateItemLocationOnCheckin
msgid "circulation.pref#UpdateItemLocationOnCheckin# Note: PROC and CART are special values, for these locations the location and permanent_location can differ, in all other cases an update will affect both. Items in the CART location will be returned to their permanent location on checkout.<br/>"
msgstr "circulation.pref#UpdateItemLocationOnCheckin# Qeyd: PROC və CART xüsusi dəyərlərdir. Bu yerləşmələrdə “hazırkı yer (location)” və “daimi yer (permanent_location)” fərqli ola bilər. Digər bütün hallarda isə edilən dəyişiklik hər iki sahəyə təsir edir. CART yerləşməsində olan kitablar checkout zamanı öz daimi yerlərinə qaytarılır."

# Circulation > Checkin policy > UpdateItemLocationOnCheckin
msgid "circulation.pref#UpdateItemLocationOnCheckin# PROC: FIC - causes an item in the Processing center location to be updated into the Fiction location on check in.<br/>"
msgstr "circulation.pref#UpdateItemLocationOnCheckin# PROC: FIC Emal mərkəzində olan kitab qaytarılanda avtomatik bədii ədəbiyyat bölməsinə keçir."

# Circulation > Checkin policy > UpdateItemLocationOnCheckin
msgid "circulation.pref#UpdateItemLocationOnCheckin# PROC: _PERM_ - causes an item that is in the Processing center to be updated to its permanent location.<br/><br/>"
msgstr "circulation.pref#UpdateItemLocationOnCheckin# PROC: _PERM_ Emal mərkəzində olan kitab qaytarılanda öz əsas (daimi) yerinə qaytarılır."

# Circulation > Checkin policy > UpdateItemLocationOnCheckin
msgid "circulation.pref#UpdateItemLocationOnCheckin# The special term _ALL_ is used on the left side of the colon (:) to affect all items, <strong>and overrides all other rules.</strong>"
msgstr "circulation.pref#UpdateItemLocationOnCheckin# Xüsusi _ALL_ termini iki nöqtənin (:) sol tərəfində bütün nüsxələrə tətbiq etmək üçün istifadə olunur, <strong>və bütün digər qaydaları ləğv edir.</strong>"

# Circulation > Checkin policy > UpdateItemLocationOnCheckin
msgid "circulation.pref#UpdateItemLocationOnCheckin# The special term _BLANK_ may be used on either side of a value pair to update or remove the location from items with no location assigned.<br/>"
msgstr "circulation.pref#UpdateItemLocationOnCheckin# Əgər kitabın yeri boşdursa, BLANK istifadə edilərək onun yeri ya dəyişdirilir, ya da silinir."

# Circulation > Checkin policy > UpdateItemLocationOnCheckin
msgid "circulation.pref#UpdateItemLocationOnCheckin# This is a list of value pairs. The first value is followed immediately by colon space then the second value."
msgstr "circulation.pref#UpdateItemLocationOnCheckin# Bu, dəyər cütlüklərinin siyahısıdır. Birinci dəyərdən sonra dərhal iki nöqtə və boşluq gəlir, daha sonra ikinci dəyər yazılır."

# Circulation > Checkin policy > UpdateItemLocationOnCheckin
msgid "circulation.pref#UpdateItemLocationOnCheckin# Valid values are <a href='/cgi-bin/koha/admin/authorised_values.pl?searchfield=LOC'>LOC</a> authorised values, _BLANK_, _PERM_, and _ALL_.<br><br>"
msgstr "circulation.pref#UpdateItemLocationOnCheckin# Valid values are <a href='/cgi-bin/koha/admin/authorised_values.pl?searchfield=LOC'>LOC</a> authorised values, _BLANK_, _PERM_, and _ALL_.<br><br> Burada istifadə oluna bilən dəyərlər bunlardır: LOC siyahısındakı yerləşmələr, BLANK, PERM və ALL."

# Circulation > Checkin policy > UpdateItemLocationOnCheckin
msgid "circulation.pref#UpdateItemLocationOnCheckin# _ALL_: FIC - causes all items to be updated into the Fiction location on check in.<br/>"
msgstr "circulation.pref#UpdateItemLocationOnCheckin# _ALL_: FIC Kitab qaytarılanda hamısı avtomatik Fiction bölməsinə keçirilir."

# Circulation > Checkin policy > UpdateItemLocationOnCheckin
msgid "circulation.pref#UpdateItemLocationOnCheckin# _BLANK_: FIC - causes an item that has no location to be updated into the Fiction location on check in.<br/>"
msgstr "circulation.pref#UpdateItemLocationOnCheckin# _BLANK_: FIC -Yeri boş olan kitab qaytarılanda avtomatik Fiction bölməsinə düşür."

# Circulation > Checkout policy > OnSiteCheckouts
# Circulation > Holds policy
msgid "circulation.pref#UpdateItemLocationOnCheckout# Examples:<br/>"
msgstr "circulation.pref#UpdateItemLocationOnCheckout# Nümunələr:<br/>"

# Circulation > Checkin policy > UpdateItemLocationOnCheckout
msgid "circulation.pref#UpdateItemLocationOnCheckout# FIC: GEN - causes an item in the Fiction location to be updated into the General stacks location on check out.<br/>"
msgstr "circulation.pref#UpdateItemLocationOnCheckout# FIC: GEN -Kitab götürüləndə Fiction bölməsindən çıxıb ümumi rəflərə keçir."

# Circulation > Checkin policy > UpdateItemLocationOnCheckout
msgid "circulation.pref#UpdateItemLocationOnCheckout# FIC: _BLANK_ - causes an item in location FIC to be updated to a blank location on check out.<br/>"
msgstr "circulation.pref#UpdateItemLocationOnCheckout# FIC: _BLANK_ - Kitab götürüləndə onun yeri silinir və boş qalır."

# Circulation > Checkin policy > UpdateItemLocationOnCheckout
msgid "circulation.pref#UpdateItemLocationOnCheckout# General rule: if the location value on the left of the colon (:) matches the item's current location, it will be updated to match the location value on the right of the colon (:).<br/>"
msgstr "circulation.pref#UpdateItemLocationOnCheckout# Ümumi qayda: iki nöqtədən (:) sol tərəfdəki yerləşmə dəyəri nüsxənin cari yerləşməsi ilə uyğun gəlirsə, o, iki nöqtədən (:) sağ tərəfdəki yerləşmə dəyərinə uyğun olaraq yenilənəcək.<br/>"

# Circulation > Checkin policy > UpdateItemLocationOnCheckout
msgid "circulation.pref#UpdateItemLocationOnCheckout# Note: PROC and CART are special values, for these locations the location and permanent_location can differ, in all other cases an update will affect both. Items in the CART location will be returned to their permanent location on checkout.<br/>"
msgstr "circulation.pref#UpdateItemLocationOnCheckout# Qeyd: PROC və CART xüsusi dəyərlərdir. Bu yerləşmələr üçün location və permanent_location fərqli ola bilər. Digər bütün hallarda yeniləmə hər ikisinə təsir edəcək. CART yerləşməsində olan nüsxələr qaytarılma zamanı öz daimi yerləşməsinə qaytarılacaq.<br/>"

# Circulation > Checkin policy > UpdateItemLocationOnCheckout
msgid "circulation.pref#UpdateItemLocationOnCheckout# PROC: FIC - causes an item in the Processing Center location to be updated into the Fiction location on check out.<br/>"
msgstr "PROC: FIC — emal mərkəzi yerləşməsində olan nüsxənin qaytarılma zamanı Fiction yerləşməsinə yenilənməsinə səbəb olur.<br/>"

# Circulation > Checkout policy > UpdateItemLocationOnCheckout
msgid "circulation.pref#UpdateItemLocationOnCheckout# PROC: _PERM_ - causes an item that is in the Processing Center to be updated to its permanent location.<br/><br/>"
msgstr "Emal mərkəzində olan kitab götürüləndə öz əsas (daimi) yerinə qaytarılır"

# Circulation > Checkin policy > UpdateItemLocationOnCheckout
msgid "circulation.pref#UpdateItemLocationOnCheckout# The special term _ALL_ is used on the left side of the colon (:) to affect all items, <strong>and overrides all other rules.</strong>"
msgstr "circulation.pref#UpdateItemLocationOnCheckout# Xüsusi _ALL_ termini iki nöqtənin (:) sol tərəfində bütün nüsxələrə tətbiq etmək üçün istifadə olunur, <strong>və bütün digər qaydaları ləğv edir.</strong>"

# Circulation > Checkin policy > UpdateItemLocationOnCheckout
msgid "circulation.pref#UpdateItemLocationOnCheckout# The special term _BLANK_ may be used on either side of a value pair to update or remove the location from items with no location assigned.<br/>"
msgstr "circulation.pref#UpdateItemLocationOnCheckout# Xüsusi _BLANK_ termini yerləşmə təyin edilməmiş nüsxələrin yerləşməsini yeniləmək və ya silmək üçün dəyər cütünün hər iki tərəfində istifadə oluna bilər.<br/>"

# Circulation > Checkin policy > UpdateItemLocationOnCheckout
msgid "circulation.pref#UpdateItemLocationOnCheckout# This is a list of value pairs. The first value is followed immediately by colon space then the second value.<br/><br/>"
msgstr "circulation.pref#UpdateItemLocationOnCheckout# Bu, dəyər cütlərinin siyahısıdır. Birinci dəyərdən dərhal sonra iki nöqtə və boşluq, sonra isə ikinci dəyər gəlir.<br/><br/>"

# Circulation > Checkin policy > UpdateItemLocationOnCheckout
msgid "circulation.pref#UpdateItemLocationOnCheckout# _ALL_: FIC - causes all items to be updated into the Fiction location on check out.<br/>"
msgstr "circulation.pref#UpdateItemLocationOnCheckout# _ALL_: FIC - verilmə zamanı bütün nüsxələri Fiction yerləşməsinə dəyişir.<br/>"

# Circulation > Checkin policy > UpdateItemLocationOnCheckout
msgid "circulation.pref#UpdateItemLocationOnCheckout# _BLANK_: FIC - causes an item that has no location to be updated into the Fiction location on check out.<br/>"
msgstr "circulation.pref#UpdateItemLocationOnCheckout# _BLANK_: FIC - verilmə zamanı yerləşməsi olmayan nüsxəni Fiction yerləşməsinə dəyişir.<br/>"

