msgstr "circulation.pref#UpdateItemWhenLostFromHoldList# 'Götürüləcək rezervlər' səhifəsindən LOST (itmiş) kimi işarələndikdə, nüsxənin dəyərlərini yeniləmək üçün istifadə ediləcək dəyərlər siyahısı."

# Circulation > Holds policy > UpdateItemWhenLostFromHoldList
msgid "circulation.pref#UpdateItemWhenLostFromHoldList# Example: \"itemlost: 1\" to set items.itemlost to 1 when the item is marked as <a href=\"/cgi-bin/koha/admin/authorised_values.pl?searchfield=LOST\">LOST</a>. (Requires <a href=\"/cgi-bin/koha/admin/preferences.pl?op=search&searchfield=CanMarkHoldsToPullAsLost\">CanMarkHoldsToPullAsLost</a>)"
msgstr "circulation.pref#UpdateItemWhenLostFromHoldList# Nümunə: nüsxə <a href=\"/cgi-bin/koha/admin/authorised_values.pl?searchfield=LOST\">LOST</a> kimi işarələndikdə items.itemlost dəyərini 1 etmək üçün \"itemlost: 1\". (<a href=\"/cgi-bin/koha/admin/preferences.pl?op=search&searchfield=CanMarkHoldsToPullAsLost\">CanMarkHoldsToPullAsLost</a> tələb olunur)"

