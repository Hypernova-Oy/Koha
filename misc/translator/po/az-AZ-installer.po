#: installer/data/mysql/en/optional/sample_news.yml:additional_contents_localizations:2:row:5:mul:1
msgid "%sThe online catalog uses functional cookies: these are essential to make the site work.%s"
msgstr "%sOnlayn kataloq funksional kukilərdən (cookies) istifadə edir: bunlar saytın işləməsi üçün zəruridir.%s"

#: installer/data/mysql/en/optional/sample_news.yml:additional_contents_localizations:2:row:6:mul:1
